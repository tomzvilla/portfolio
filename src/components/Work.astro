---
import type { Lang } from '../i18n/types';
import { t, workPath } from '../i18n/utils';
import { getWork, slugOf } from '../lib/work';

interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
const w = d.work;
const entries = await getWork(lang);
---
<section class="work" id={d.ids.work} aria-labelledby="work-title">
  <div class="sh rv"><span class="n">{w.n}</span><h2 id="work-title">{w.title}</h2></div>
  <p class="lead rv" style="--d:100ms">{w.lead}</p>
  <ol class="rows">
    {entries.map((e, i) => (
      <li class="rv" style={`--d:${i * 60}ms`}>
        <a class="row" href={workPath(lang, slugOf(e))}>
          <span class="y mono">{e.data.period}</span>
          <span class="t">{e.data.title}<small>{e.data.client}</small></span>
          <span class="d"><b>{e.data.problem}</b> {e.data.summary}</span>
          <span class="r mono">{e.data.role}{e.data.stack.length > 0 && <Fragment><br />{e.data.stack.join(' · ')}</Fragment>}</span>
          <span class="go mono" aria-hidden="true">{w.see}</span>
        </a>
      </li>
    ))}
  </ol>
</section>

<style>
  .work { padding: 80px var(--px) 60px; border-top: 1px solid var(--line); }
  .row {
    position: relative; isolation: isolate;
    display: grid; grid-template-columns: 80px 1.1fr 1.8fr 190px 70px; gap: 22px; align-items: baseline;
    padding: 22px 0; border-bottom: 1px solid var(--line);
    color: inherit; text-decoration: none;
    transition: transform .25s var(--ease);
  }
  .row::before {
    content: ''; position: absolute; inset: 0 -16px; z-index: -1;
    background: var(--surface); opacity: 0; transition: opacity .25s;
  }
  .row:hover { transform: translateX(3px); }
  .row:hover::before { opacity: 1; }
  .row:hover .t { color: var(--amber-ink); }
  .row:hover .go { color: var(--amber-ink); transform: translateX(4px); }
  .y { font-size: 12px; color: var(--muted); }
  .t { font-size: 18px; color: var(--strong); font-weight: 500; transition: color .2s; }
  .t small { display: block; margin-top: 3px; font-size: 12px; color: var(--muted); font-weight: 400; }
  .d { font-size: 14px; color: var(--text2); line-height: 1.55; font-weight: 300; }
  .d b { color: var(--text); font-weight: 400; }
  .r { font-size: 11px; color: var(--muted); line-height: 1.6; text-transform: uppercase; }
  .go { font-size: 11px; color: var(--faint); text-align: right; transition: color .2s, transform .25s; }

  @media (max-width: 900px) {
    .row { grid-template-columns: 1fr; gap: 6px; padding: 18px 0; }
    .row:hover { transform: none; }
    .go { text-align: left; }
  }
  @media (max-width: 600px) {
    .work { padding-block: 56px 40px; }
  }
</style>
