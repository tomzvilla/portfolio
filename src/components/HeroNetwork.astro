---
import { createBodies, EDGES, edgePath, nodeRadius, VIEW } from '../scripts/hero-physics';

const bodies = createBodies();
---
<div class="vec" aria-hidden="true">
  <svg viewBox={`0 0 ${VIEW.w} ${VIEW.h}`} preserveAspectRatio="xMaxYMid meet" focusable="false">
    {EDGES.map((e, i) => <path d={edgePath(bodies, e)} style={`animation-delay:${(0.3 + i * 0.1).toFixed(2)}s`} />)}
    {bodies.map((b, i) => <circle cx={b.x} cy={b.y} r={nodeRadius(i)} style={`animation-delay:${(0.15 + i * 0.07).toFixed(2)}s`} />)}
  </svg>
</div>

<script>
  import { bfsDepths, createBodies, EDGES, edgePath, nearest, PHYS, step, type Point } from '../scripts/hero-physics';

  const vec = document.querySelector<HTMLElement>('.vec');
  const hero = vec?.closest<HTMLElement>('[data-hero]');
  const svg = vec?.querySelector('svg');

  if (vec && hero && svg) {
    const paths = [...svg.querySelectorAll('path')];
    const circles = [...svg.querySelectorAll('circle')];
    const shapes = [...paths, ...circles];
    const markShown = () => shapes.forEach((el) => el.classList.add('shown'));
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const mobile = matchMedia('(max-width: 600px)');

    if (reduce) {
      markShown();
    } else {
      shapes.forEach((el) => el.addEventListener('animationend', () => el.classList.add('shown'), { once: true }));
      setTimeout(markShown, 2900);

      const bodies = createBodies();
      let cursor: Point | null = null;
      let active: number | null = null;
      let raf = 0;

      const render = () => {
        EDGES.forEach((e, i) => paths[i].setAttribute('d', edgePath(bodies, e)));
        bodies.forEach((b, i) => {
          circles[i].setAttribute('cx', b.x.toFixed(1));
          circles[i].setAttribute('cy', b.y.toFixed(1));
        });
      };
      const loop = () => {
        const moving = step(bodies, cursor);
        render();
        raf = moving ? requestAnimationFrame(loop) : 0;
      };
      const kick = () => {
        if (!raf) raf = requestAnimationFrame(loop);
      };
      const setActive = (i: number | null) => {
        active = i;
        paths.forEach((p, k) => p.classList.toggle('on', i !== null && EDGES[k].includes(i)));
        circles.forEach((c, k) => c.classList.toggle('hi', k === i));
      };
      const toSvg = (e: MouseEvent): Point | null => {
        const m = svg.getScreenCTM();
        if (!m) return null;
        const p = new DOMPoint(e.clientX, e.clientY).matrixTransform(m.inverse());
        return { x: p.x, y: p.y };
      };

      hero.addEventListener('mousemove', (e) => {
        if (mobile.matches) return;
        const pt = toSvg(e);
        if (!pt) return;
        cursor = pt;
        const n = nearest(bodies, pt, PHYS.hoverRadius);
        if (n !== active) setActive(n);
        kick();
      });
      hero.addEventListener('mouseleave', () => {
        cursor = null;
        setActive(null);
        kick();
      });
      hero.addEventListener('click', (e) => {
        if (mobile.matches) return;
        const pt = toSvg(e);
        if (!pt) return;
        const start = nearest(bodies, pt, PHYS.clickRadius);
        if (start === null) return;
        bfsDepths(start).forEach((depth, i) => {
          if (depth < 0) return;
          setTimeout(() => {
            circles[i].classList.add('wv');
            bodies[i].vx += (Math.random() - 0.5) * 6;
            bodies[i].vy += (Math.random() - 0.5) * 6;
            kick();
            setTimeout(() => circles[i].classList.remove('wv'), PHYS.waveHoldMs);
          }, depth * PHYS.waveStepMs);
        });
      });
    }
  }
</script>

<style>
  .vec {
    position: absolute; top: 0; bottom: 0; right: 0; z-index: 0;
    width: min(460px, 38vw);
    pointer-events: none;
    mask-image: linear-gradient(90deg, transparent, var(--strong) 30%);
    -webkit-mask-image: linear-gradient(90deg, transparent, var(--strong) 30%);
  }
  :global(.js) .vec { opacity: 0; transition: opacity 1.2s .3s; }
  :global(.js [data-hero].in) .vec { opacity: 1; }
  svg { width: 100%; height: 100%; }

  path { fill: none; stroke: var(--line2); stroke-width: 1; transition: stroke .3s; }
  :global(.js) path:not(.shown) {
    stroke-dasharray: 900; stroke-dashoffset: 900;
    animation: drawin 2.2s var(--ease) forwards;
  }
  path.on { stroke: var(--amber); stroke-dasharray: 5 7; animation: flow 1.2s linear infinite; }

  circle { fill: var(--bg); stroke: var(--vecnode); stroke-width: 1.2; transition: stroke .3s, fill .3s; }
  :global(.js) circle:not(.shown) { opacity: 0; animation: ndin .6s forwards; }
  circle.hi { stroke: var(--amber); fill: var(--amber); }
  circle.wv { stroke: var(--amber); fill: var(--surfacehi); }

  @media (max-width: 600px) {
    .vec { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.js) path:not(.shown) { stroke-dashoffset: 0; stroke-dasharray: none; }
    :global(.js) circle:not(.shown) { opacity: 1; }
  }
</style>
