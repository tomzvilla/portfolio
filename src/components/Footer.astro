---
import { REPO } from '../config';
import type { Lang } from '../i18n/types';
import { t } from '../i18n/utils';

interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
---
<footer class="ft mono">
  <span class="sign">{d.footer.sign}</span>
  <a href={REPO}>{d.footer.source}</a>
</footer>

<style>
  .ft {
    display: flex; justify-content: space-between; gap: 12px;
    padding: 24px var(--px); border-top: 1px solid var(--line); font-size: 11px;
  }
  .sign { color: var(--faint); }
  a { color: var(--muted); text-decoration: none; transition: color .2s; }
  a:hover { color: var(--amber-ink); }
  @media (max-width: 600px) {
    .ft { flex-direction: column; gap: 6px; padding-block: 20px; }
  }
</style>
